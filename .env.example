# ==============================================================================
# SentinelZ AI — Environment Configuration Template
# Datathon Track: IBM Z Datathon 2026 — AI Secured: Innovation Without Exposure
# ==============================================================================

# Backend Port and Host
SENTINELZ_PORT=8000
SENTINELZ_HOST=0.0.0.0

# Cryptographic Session Key (Change in production on IBM LinuxONE)
SENTINELZ_SECRET_KEY=sentinelz-change-in-production-ibm-linuxone-secret-2026

# Database Persistence
# Default: Local SQLite database
DATABASE_URL=sqlite:///./sentinelz.db
# Production IBM LinuxONE Db2 / PostgreSQL alternative:
# DATABASE_URL=postgresql://sentinelz_user:password@localhost:5432/sentinelz_db

# Privacy Shield & AI Provider Configuration
# Safe Default: External AI is strictly DISABLED out of the box (Zero Exposure)
SENTINELZ_AI_ENABLED=false
SENTINELZ_AI_PROVIDER=local_deterministic
SENTINELZ_AI_MODEL=sentinelz-sec-bert-local

# Optional External AI Credentials (Only used if SENTINELZ_AI_ENABLED=true)
# Privacy Shield guarantees only sanitized, anonymized tokens are dispatched
SENTINELZ_AI_API_KEY=

# Ingestion & DoS Mitigation Constraints
SENTINELZ_MAX_REQUEST_SIZE_BYTES=1048576

# Next.js Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api
